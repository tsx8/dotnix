+def _mirror_lock_state():
+    # Caps Lock state is invisible to fcitx5; mirror every toggle into the
+    # Rime ascii option (delayed past the compositor's LED update) so the
+    # input indicator tracks the physical lock. Best effort: a missed mirror
+    # self-corrects at the next toggle.
+    def worker():
+        try:
+            import glob
+            import dbus
+            time.sleep(0.15)
+            on = any(open(p).read().strip() == "1" for p in glob.glob(
+                "/sys/class/leds/*::capslock/brightness"))
+            bus = dbus.SessionBus()
+            bus.get_object("org.fcitx.Fcitx5", "/rime").SetAsciiMode(
+                on, dbus_interface="org.fcitx.Fcitx.Rime1", timeout=0.5)
+        except Exception:
+            pass
+    import threading
+    threading.Thread(target=worker, daemon=True).start()
+
 _MODMAPS: 'list[Modmap]' = None

+            content += `\n  ${theme.fg("dim", line)}`;
+          }
+          if (valueLines.length > RESULT_VALUE_LINES) {
+            content += `\n${theme.fg("muted", `... (${valueLines.length - RESULT_VALUE_LINES} more lines)`)}`;
+          }
+        }
+      }
+
+      text.setText(content);
+      return text;

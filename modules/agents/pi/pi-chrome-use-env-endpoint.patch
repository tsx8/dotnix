+          .filter((line) => line.trim())
+          .slice(-3);
+        for (const line of tail) {
+          content += `\n${theme.fg("dim", line)}`;
+        }
+        text.setText(content);
+        return text;
+      }
+
+      // 对齐内置 bash：结果只显示输出本身，无状态行；无输出无返回值则不显示。

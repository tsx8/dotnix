+        }
+        if (value) {
+          content += `${content ? "\n" : ""}${theme.fg(
+            "dim",
+            `=> ${valueTruncated ? valueHead.slice(0, RESULT_HEAD_CHARS - 1) + "…" : valueHead}`,
+          )}`;
+        }
+        if (outputLines.length > RESULT_CONSOLE_PREVIEW || valueTruncated) {
+          content += `\n${theme.fg("muted", `... (${keyHint("app.tools.expand", "to expand")})`)}`;
+        }
+      } else {
+        for (const line of outputLines) {
+          content += `${content ? "\n" : ""}${theme.fg("dim", line)}`;
+        }
+        if (value) {
+          content += `${content ? "\n" : ""}${theme.fg("accent", "=>")}`;

{
  "mcpServers": {
    "mcp-dotnix": {
      "command": "bash",
      "args": [
        "-c",
        "exec \"$(git rev-parse --show-toplevel)/scripts/sh/mcp.sh\" \"$1\"",
        "mcp-dotnix",
        "mcp-dotnix"
      ],
      "exposure": "hidden",
      "timeout": 600,
      "toolExposure": {
        "system_status": "direct",
        "unit_status": "direct",
        "unit_journal": "direct",
        "kernel_log": "direct",
        "boot_list": "direct",
        "disk_status": "direct",
        "network_status": "direct",
        "nixos_generations": "direct"
      }
    },
    "mcp-nixos": {
      "command": "bash",
      "args": [
        "-c",
        "exec \"$(git rev-parse --show-toplevel)/scripts/sh/mcp.sh\" \"$1\"",
        "mcp-nixos",
        "mcp-nixos"
      ],
      "exposure": "hidden",
      "timeout": 120,
      "toolExposure": {
        "nix": "direct",
        "nix_versions": "direct"
      }
    }
  }
}
